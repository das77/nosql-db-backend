# Values here assume running the API directly on the host (`npm run dev` / `npm start`)
# against a Mongo reachable at localhost.
#
# Under `docker compose up`, MONGO_URI is set by docker-compose.yml (the api container
# reaches Mongo at the service name `mongo`) and the value below is ignored — PORT and
# JWT_SECRET are still read from your .env.
#
# Docker Compose interpolates $VAR / $$-escaping in values it reads from .env, including
# via env_file. If JWT_SECRET contains a literal `$` followed by letters/digits/underscore
# (e.g. `$abc123`), Compose treats it as a variable reference and silently drops it if
# that variable isn't set — the container then runs with a DIFFERENT secret than what's
# written here. Either avoid `$` in JWT_SECRET, or escape every literal `$` as `$$`.
PORT=3000
MONGO_URI=mongodb://localhost:27017/app
JWT_SECRET=change-me-to-a-long-random-string
