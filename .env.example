# Default values assume running via `docker compose up` (Mongo reachable at host `mongo`).
# For running the API directly on the host with `npm start`/`npm run dev`, point
# MONGO_URI at localhost instead, e.g. mongodb://localhost:27017/app
PORT=3000
MONGO_URI=mongodb://mongo:27017/app
JWT_SECRET=change-me-to-a-long-random-string
